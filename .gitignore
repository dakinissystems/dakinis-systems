# --- Control repo: no versionar clones de producto / platform (tienen su propio remoto) ---
# /apps/* ignorado salvo Fitness (P-08 B — versionado en meta hasta releases propios)
/apps/*
!/apps/fitness-platform/
!/apps/fitness-platform/**
/platform/

# --- Proyectos locales fuera del control repo ---
# Hub/AI viven bajo /platform/ (cubierto por /platform/)
