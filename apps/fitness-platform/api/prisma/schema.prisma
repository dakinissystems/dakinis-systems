generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  TRAINER
  CLIENT
  STAFF
}

enum TrackingFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum FeedbackType {
  ROUTINE_CHANGE
  PAIN
  DIFFICULTY
  OBJECTIVE_CHANGE
  BODY_UPDATE
}

enum FeedbackStatus {
  OPEN
  REVIEWING
  CLOSED
}

enum ClientRoutineStatus {
  ACTIVE
  PAUSED
  FINISHED
}

model Tenant {
  id        String      @id @default(cuid())
  slug      String      @unique
  name      String
  users     User[]
  exercises Exercise[]
  routines  Routine[]
  createdAt DateTime    @default(now())
}

model User {
  id                String              @id @default(cuid())
  tenantId          String
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role              Role
  email             String
  passwordHash      String
  name              String?
  phone             String?
  isActive          Boolean             @default(true)
  avatarUrl         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  clientProfile     ClientProfile?
  trainedProfiles   ClientProfile[]     @relation("TrainerClients")
  feedbackForTrainer FeedbackRequest[]  @relation("FeedbackTrainer")

  @@unique([tenantId, email])
  @@index([tenantId, role])
}

model ClientProfile {
  id                   String               @id @default(cuid())
  userId               String               @unique
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainerId            String
  trainer              User                 @relation("TrainerClients", fields: [trainerId], references: [id], onDelete: Cascade)
  birthDate            DateTime?
  gender               String?
  heightCm             Float?
  objective            String?
  activityLevel        String?
  medicalNotes         String?
  injuries             String?
  trackingFrequency    TrackingFrequency    @default(WEEKLY)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  bodyMetrics          BodyMetric[]
  clientRoutines       ClientRoutine[]
  workoutLogs          WorkoutLog[]
  feedbackFromClient   FeedbackRequest[]    @relation("FeedbackClient")

  @@index([trainerId])
}

model BodyMetric {
  id               String         @id @default(cuid())
  clientProfileId  String
  client           ClientProfile  @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  weightKg         Float?
  bodyFatPercent   Float?
  muscleMassKg     Float?
  waterPercent     Float?
  bmi              Float?
  chestCm          Float?
  waistCm          Float?
  hipsCm           Float?
  armsCm           Float?
  legsCm           Float?
  notes            String?
  recordedAt       DateTime       @default(now())
  createdBy        String?

  @@index([clientProfileId, recordedAt])
}

model Exercise {
  id           String           @id @default(cuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  muscleGroup  String?
  equipment    String?
  videoUrl     String?
  imageUrl     String?
  difficulty   String?

  @@unique([tenantId, name])
  @@index([tenantId])
  routineUsages RoutineExercise[]
}

model Routine {
  id              String           @id @default(cuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trainerId       String
  title           String
  description     String?
  goal            String?
  difficulty      String?
  durationWeeks   Int?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  days            RoutineDay[]
  clientRoutines  ClientRoutine[]

  @@index([tenantId, trainerId])
}

model RoutineDay {
  id         String            @id @default(cuid())
  routineId  String
  routine    Routine           @relation(fields: [routineId], references: [id], onDelete: Cascade)
  dayNumber  Int
  title      String?
  notes      String?
  exercises  RoutineExercise[]

  @@index([routineId])
}

model RoutineExercise {
  id            String     @id @default(cuid())
  routineDayId  String
  day           RoutineDay @relation(fields: [routineDayId], references: [id], onDelete: Cascade)
  exerciseId    String
  exercise      Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sets          Int?
  reps          String?
  restSeconds   Int?
  weightNotes   String?
  tempo         String?
  orderIndex    Int        @default(0)

  workoutLogs WorkoutLog[]

  @@index([routineDayId])
}

model ClientRoutine {
  id               String               @id @default(cuid())
  clientProfileId  String
  client           ClientProfile        @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  routineId        String
  routine          Routine              @relation(fields: [routineId], references: [id], onDelete: Cascade)
  startDate        DateTime             @default(now())
  endDate          DateTime?
  status           ClientRoutineStatus  @default(ACTIVE)
  trainerNotes     String?
  clientNotes      String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([clientProfileId, status])
}

model WorkoutLog {
  id                   String           @id @default(cuid())
  clientProfileId      String
  client               ClientProfile    @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  routineExerciseId    String
  routineExercise      RoutineExercise  @relation(fields: [routineExerciseId], references: [id], onDelete: Cascade)
  completed            Boolean          @default(true)
  performedReps        String?
  performedWeightKg    Float?
  difficultyScore      Int?
  painLevel            Int?
  notes                String?
  performedAt          DateTime         @default(now())

  @@index([clientProfileId, performedAt])
}

model FeedbackRequest {
  id               String           @id @default(cuid())
  clientProfileId  String
  client           ClientProfile    @relation("FeedbackClient", fields: [clientProfileId], references: [id], onDelete: Cascade)
  trainerId        String
  trainer          User             @relation("FeedbackTrainer", fields: [trainerId], references: [id], onDelete: Cascade)
  type             FeedbackType
  message          String
  status           FeedbackStatus   @default(OPEN)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([trainerId, status])
}
